@model PlayerProfileViewModel
@{ ViewData["Title"] = "Manage " + Model.Profile.DisplayName; var p = Model.Profile; var audit = ViewBag.Audit as IReadOnlyList<ProfileAuditEntry> ?? []; }
<section class="page-heading"><p class="eyebrow">MANAGE PROFILE</p><h1>@p.DisplayName</h1><p>Verified results stay read-only here. Source link requests remain pending until the future verification service approves them.</p><a href="/players/@p.Slug">View public profile</a></section>
<div class="admin-grid">
    <section class="panel"><h2>Profile details</h2><form asp-action="Update" asp-route-id="@p.Id" method="post" class="form-grid">
        <label>Display name<input name="DisplayName" value="@p.DisplayName" maxlength="80" required /></label><label>Headline<input name="Headline" value="@p.Headline" maxlength="120" /></label><label class="wide">Biography<textarea name="Biography" maxlength="2000">@p.Biography</textarea></label><label>Home room<input name="HomeRoom" value="@p.HomeRoom" /></label><label>City<input name="Locality" value="@p.Locality" /></label><label>State or region<input name="Region" value="@p.Region" /></label><label>Country code<input name="CountryCode" value="@p.CountryCode" pattern="[A-Z]{2}" /></label><label>Primary game<input name="PrimaryDiscipline" value="@p.PrimaryDiscipline" required /></label><div class="wide"><button class="button">Save details</button></div>
    </form></section>
    <section class="panel"><h2>Add an informal achievement</h2><p class="muted">It will always be labeled “Player reported.”</p><form asp-action="AddAchievement" asp-route-id="@p.Id" method="post" class="form-grid"><label>Title<input name="Title" required maxlength="120" /></label><label>Game or category<input name="Discipline" value="8-ball" required /></label><label>Date<input type="date" name="AchievedOn" required /></label><label>Community or event label<input name="SourceLabel" value="Player reported" /></label><label class="wide">Description<textarea name="Description" maxlength="600"></textarea></label><label class="wide">Evidence link (optional)<input type="url" name="EvidenceUrl" /></label><div class="wide"><button class="button">Add achievement</button></div></form></section>
    <section class="panel"><h2>Public social links</h2><p class="muted">Only public Facebook and X pages are accepted. No passwords or tokens are stored.</p><form asp-action="UpdateSocial" asp-route-id="@p.Id" method="post" class="form-grid"><label class="wide">Facebook Page or public post URL<input type="url" name="FacebookUrl" value="@p.SocialLinks.FirstOrDefault(x => x.Provider == SocialProvider.Facebook)?.PublicUrl" /></label><label class="check"><input type="checkbox" name="FacebookEmbedEnabled" value="true" @(p.SocialLinks.FirstOrDefault(x => x.Provider == SocialProvider.Facebook)?.EmbedEnabled == true ? "checked" : null) /> Offer click-to-load Facebook feed</label><label class="wide">X public profile URL<input type="url" name="XUrl" value="@p.SocialLinks.FirstOrDefault(x => x.Provider == SocialProvider.X)?.PublicUrl" /></label><label class="check"><input type="checkbox" name="XEmbedEnabled" value="true" @(p.SocialLinks.FirstOrDefault(x => x.Provider == SocialProvider.X)?.EmbedEnabled == true ? "checked" : null) /> Offer click-to-load X feed</label><div class="wide"><button class="button">Save social links</button></div></form></section>
    <section class="panel"><h2>Request a source link</h2><form asp-action="AddSourceLink" asp-route-id="@p.Id" method="post" class="form-grid"><label>Product<select name="product"><option value="League">League</option><option value="Tournament">Tournament</option></select></label><label>Organization key<input name="tenantKey" required /></label><label>Local player ID<input name="sourceEntityId" required /></label><label>Display label<input name="displayLabel" required /></label><div class="wide"><button class="button secondary">Create pending request</button></div></form>@foreach (var link in p.SourceLinks) { <div class="source-row"><span class="status @link.Status.ToString().ToLowerInvariant()">@link.Status</span><span>@link.Product · @link.DisplayLabel</span></div> }</section>
    @if (User.IsInRole("Owner") || User.IsInRole("ProfileAdmin")) { <section class="panel"><h2>Publication</h2><form asp-action="SetStatus" asp-route-id="@p.Id" method="post" class="form-grid"><label>Status<select name="status">@foreach (var status in Enum.GetValues<ProfileStatus>()) { <option value="@status" selected="@(status == p.Status)">@status</option> }</select></label><label class="wide">Required reason<input name="reason" required maxlength="500" /></label><div class="wide"><button class="button warning">Update status</button></div></form></section> }
    <section class="panel"><h2>History</h2>@if (audit.Count == 0) { <p class="empty">No management changes in this development session.</p> } @foreach (var entry in audit) { <div class="audit"><strong>@entry.Action.Replace('_',' ')</strong><span>@entry.Reason</span><small>@entry.Actor · @entry.OccurredAt.ToLocalTime().ToString("g")</small></div> }</section>
</div>
