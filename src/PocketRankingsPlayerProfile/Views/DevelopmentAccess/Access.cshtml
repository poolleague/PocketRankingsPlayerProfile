@model string
@{ ViewData["Title"] = "Development access"; }
<section class="access-card"><p class="eyebrow">LOCAL DEVELOPMENT ONLY</p><h1>Choose a fictional role</h1><p>This page is unavailable outside Development and does not replace the future Pocket Rankings Account sign-in.</p>@foreach (var role in new[] { "Owner", "ProfileAdmin", "Player" }) { <form asp-action="SignInAs" method="post"><input type="hidden" name="role" value="@role" /><input type="hidden" name="returnUrl" value="@Model" /><button class="button wide-button">Continue as @role</button></form> }</section>
